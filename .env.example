BCK_APP_NAME=Factored AI Backend
BCK_ENVIRONMENT=development
BCK_ENABLE_DOCS=true
# Puerto publicado por Docker Compose; no modifica el puerto interno del contenedor.
BCK_PORT=8000

# JSON array; vacío exige Specialist para critical. Mismo valor en todos los workers.
BCK_CRITICAL_SENIOR_FALLBACK_REASONS=[]

# TTL server-side de confirmaciones pendientes, 30–900 segundos.
BCK_CONFIRMATION_SECONDS=300

# Explicit engineering stub only; no real ML provider is bundled.
BCK_CONVERSATION_ADAPTER=disabled
BCK_ADAPTER_TIMEOUT_SECONDS=5
